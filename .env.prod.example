# =============================================================================
# RL Logística — Template de PRODUCCIÓN
# Copiar a .env.prod (gitignored) y rellenar con valores reales.
# Usar con: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =============================================================================

# --- Base de datos PostgreSQL -------------------------------------------------
# En prod la DB NO expone puerto al host: el backend la alcanza por red interna.
DB_HOST=db
DB_PORT=5432
DB_USERNAME=rl_prod
DB_PASSWORD=                      # REQUERIDO: openssl rand -base64 32
DB_DATABASE=logistica_palets

POSTGRES_USER=rl_prod
POSTGRES_PASSWORD=                # debe coincidir con DB_PASSWORD
POSTGRES_DB=logistica_palets

# --- TypeORM ------------------------------------------------------------------
DB_SYNCHRONIZE=false              # NUNCA true en producción
DB_MIGRATIONS_RUN=true            # aplica migrations pendientes al arrancar
DB_LOGGING=false

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=                       # REQUERIDO: openssl rand -base64 64
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=               # REQUERIDO: openssl rand -base64 64 (diferente al JWT_SECRET)
JWT_REFRESH_EXPIRES_IN=7d

# --- Bootstrap del usuario admin inicial --------------------------------------
# Sólo se usa una vez (tabla users vacía en el primer arranque). El backend
# aborta el arranque en producción si faltan o son débiles (<12 caracteres,
# o el valor por defecto "admin123").
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=         # REQUERIDO: >=12 caracteres, distinto de admin123

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info                    # trace | debug | info | warn | error

# --- Exposición pública -------------------------------------------------------
# Hay dos arquitecturas soportadas y `scripts/check-env.sh` detecta cuál usás por
# la presencia de TUNNEL_TOKEN. Definí las variables de UNA sola.
#
# A) Cloudflare Tunnel — lo que usa docker-compose.prod.yml y el de staging.
#    TLS termina en el borde de Cloudflare y el túnel sale del VPS, así que no
#    hace falta abrir 80 ni 443. El ruteo de los hostnames públicos se configura
#    en el dashboard (Zero Trust → Networks → Tunnels → Public Hostname); acá
#    sólo va el token del conector.
#
#    El token NO es el "Tunnel ID" que muestra la pantalla de detalles. Ese UUID
#    (3e20ae2b-…) identifica al túnel; el token es una cadena larga en base64 que
#    empieza con `eyJhIjoi…` y viene dentro del comando de instalación del
#    conector: `cloudflared service install <TOKEN>`, o en la variante Docker,
#    `... tunnel run --token <TOKEN>`.
#
#    Dónde sacarlo: Zero Trust → Networks → Tunnels → tu túnel → pantalla de
#    instalación del conector. Por CLI, desde una máquina con `cloudflared login`
#    hecho: `cloudflared tunnel token <nombre-o-id>`.
#
#    OJO con el botón "Rotate token" de la pantalla de detalles: NO sirve para ver
#    el token actual, lo invalida y genera otro. Si hay un conector corriendo con
#    el token viejo, se cae hasta que lo actualices. Sólo se usa si el token se
#    filtró.
TUNNEL_TOKEN=

# B) Caddy con Let's Encrypt — alternativa sin Cloudflare, ver DEPLOY.md.
#    Requiere abrir 80/443 y agregar el servicio `caddy` al compose. Los
#    dominios van SIN esquema y deben coincidir con CORS_ORIGIN/VITE_API_URL.
# APP_DOMAIN=app.tudominio.com
# API_DOMAIN=api.tudominio.com
# ACME_EMAIL=admin@tudominio.com

# --- Seguridad ----------------------------------------------------------------
# CORS: orígenes permitidos (lista separada por coma). En prod, dominio real.
CORS_ORIGIN=https://app.tudominio.com
# Rate limiting: ventana (ms) y máximo de requests por IP en esa ventana.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Saltos de proxy de confianza delante del backend. REQUERIDO en las dos
# arquitecturas de arriba: con el túnel o con Caddy, la conexión al backend la
# abre el proxy, así que sin esto `req.ip` es SIEMPRE la misma dirección para
# todos los usuarios. Consecuencias: la bitácora de accesos registra la IP del
# proxy en vez de la del cliente, y el límite de 5 intentos de login por minuto
# "por IP" pasa a ser de 5 por minuto para TODA la empresa — al tercer error de
# un operador, el resto se queda afuera.
#
# `1` es lo correcto para ambas: hay un solo salto entre el cliente y el backend
# (cloudflared, o Caddy). No lo pongas en producción si el backend llegara a
# recibir conexiones directas: ahí cualquiera podría falsificar su IP con una
# cabecera y saltearse el límite de intentos.
TRUST_PROXY=1

# --- Redis (cache + WebSocket event bus) -------------------------------------
# En docker-compose.prod.yml el backend pasa REDIS_HOST=redis (servicio interno)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=                   # si usás Redis protegido con contraseña

# --- Frontend (Vite, inyectado en build) -------------------------------------
VITE_API_URL=https://api.tudominio.com/api
VITE_WS_URL=https://api.tudominio.com

# --- Facturación electrónica Paraguay (SIFEN) --------------------------------
EMISOR_RUC=80000000
EMISOR_DV=0
EMISOR_RAZON_SOCIAL=RL SERVICIO LOGISTICO SRL
EMISOR_NOMBRE_FANTASIA=RL Logística
EMISOR_DIRECCION=Asunción, Paraguay
EMISOR_RESPONSABLE=Gerente General
FACTURA_TIMBRADO=12345678
FACTURA_VIGENCIA=2026-12-31
FACTURA_ESTABLECIMIENTO=001
FACTURA_PUNTO_EXPEDICION=001
SIFEN_URL=                        # endpoint real DNIT (vacío = simulación)
SIFEN_URL_CONSULTA=

# --- Reportes por correo (email digest diario a las 07:00) -------------------
MAIL_ENABLED=false                # cambiar a true + completar SMTP para activar
SMTP_HOST=smtp.gmail.com          # o smtp.office365.com, etc.
SMTP_PORT=587
SMTP_SECURE=false                 # true si usás puerto 465
SMTP_USER=                        # dirección de email del remitente
SMTP_PASS=                        # contraseña o app-password
MAIL_FROM=RL Logística <no-reply@tudominio.com>
MAIL_REPORT_TO=                   # destinatarios separados por coma

# --- Misc ---------------------------------------------------------------------
NODE_ENV=production
ALLOW_SEED=false                  # seed SIEMPRE bloqueado en producción
