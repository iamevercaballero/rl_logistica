# Modo "audit": apunta la UI al backend aislado de auditoría (:3001), no al de
# desarrollo (:3000). Vite sólo carga este archivo con `--mode audit`, así que el
# servidor de desarrollo normal no se ve afectado.
#
#   npm run dev -- --mode audit --port 5174
#
VITE_API_BASE_URL=http://localhost:3001/api
VITE_WS_URL=http://localhost:3001
