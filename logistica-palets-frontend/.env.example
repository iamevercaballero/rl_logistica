# ── RL Logística — Frontend (Vite + React) ────────────────────────────────────
# Copiá a `.env` (o `.env.local`) y ajustá. Todo lo VITE_* se expone al browser:
# NO pongas secretos acá.

# Base de la API REST. Default si se omite: "/api" (proxy del mismo host).
VITE_API_URL=http://localhost:3000

# Base alternativa usada por algunos clientes/exports (normalmente igual a la API).
VITE_API_BASE_URL=http://localhost:3000

# WebSocket para actualizaciones en tiempo real (dashboard/stock).
VITE_WS_URL=ws://localhost:3000
