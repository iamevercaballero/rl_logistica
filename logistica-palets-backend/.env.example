# ── RL Logística — Backend (NestJS) ───────────────────────────────────────────
# Copiá este archivo a `.env` y completá los valores. NO commitees el `.env` real.

# Entorno: development | production
NODE_ENV=development
PORT=3000

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rl_logistica
DB_PASSWORD=changeme
DB_DATABASE=rl_logistica

# Esquema: en producción usar migraciones, NO synchronize.
# DB_SYNCHRONIZE=true deja que TypeORM altere tablas solo → riesgo de pérdida de
# datos en prod. Dejar en false y aplicar cambios vía migraciones.
DB_SYNCHRONIZE=false
# Correr migraciones pendientes al arrancar (default: true en producción).
DB_MIGRATIONS_RUN=true
# Logging de queries SQL (ruidoso): true | false
DB_LOGGING=false

# ── Autenticación (JWT) ───────────────────────────────────────────────────────
# Secretos largos y aleatorios. Generá con: openssl rand -hex 48
JWT_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (caché / KPIs) ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origen del frontend permitido (ej: https://wms.tu-dominio.com)
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting (throttler) ─────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ── Logs ──────────────────────────────────────────────────────────────────────
# error | warn | log | debug | verbose
LOG_LEVEL=log

# ── Bootstrap del usuario admin inicial ───────────────────────────────────────
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme-on-first-login

# ── Seed (sólo dev / carga inicial) ───────────────────────────────────────────
# Habilita el endpoint de seed. Mantener en false en producción.
ALLOW_SEED=false
# Ruta al Excel de carga inicial (si se usa el seed)
SEED_EXCEL=
