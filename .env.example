# =============================================================================
# RL Logística — Template de variables de entorno
# Copiar a .env y rellenar con valores reales. NO commitear .env real.
# =============================================================================

# --- Base de datos PostgreSQL ---------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambia_esto_por_un_password_fuerte
DB_DATABASE=logistica_palets

# Cuando corres comandos desde tu máquina (no desde docker), usa el puerto
# expuesto por docker-compose:
#   DB_HOST=localhost
#   DB_PORT=5433

POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto_por_un_password_fuerte
POSTGRES_DB=logistica_palets

# --- TypeORM ------------------------------------------------------------------
# Activá synchronize SOLO en bootstrap inicial sobre DB vacía. Producción: false.
DB_SYNCHRONIZE=false
# Si true, NestJS aplica migrations pendientes al arrancar (recomendado prod).
DB_MIGRATIONS_RUN=true
# Si true, loguea TODAS las queries SQL. Útil en debug, ruidoso en prod.
DB_LOGGING=false

# --- Auth ---------------------------------------------------------------------
# Generar con: openssl rand -base64 64
JWT_SECRET=reemplazar_por_secreto_fuerte
JWT_EXPIRES_IN=8h
# Refresh token (DEBE ser diferente al JWT_SECRET)
# Generar con: openssl rand -base64 64
JWT_REFRESH_SECRET=reemplazar_por_otro_secreto_fuerte
JWT_REFRESH_EXPIRES_IN=7d

# --- Logging ------------------------------------------------------------------
# Nivel de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Redis (cache + WebSocket event bus) --------------------------------------
# En Docker: REDIS_HOST=redis (nombre del servicio)
# En dev local: REDIS_HOST=localhost
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Frontend (Vite) ----------------------------------------------------------
VITE_API_URL=http://localhost:3000/api
# URL base del backend para WebSocket (sin /api)
VITE_WS_URL=http://localhost:3000

# --- Facturación electrónica Paraguay (SIFEN) --------------------------------
EMISOR_RUC=80000000
EMISOR_DV=0
EMISOR_RAZON_SOCIAL="RL SERVICIO LOGISTICO SRL"
EMISOR_NOMBRE_FANTASIA="RL Logística"
EMISOR_DIRECCION="Asunción, Paraguay"
EMISOR_RESPONSABLE="Gerente General"
FACTURA_TIMBRADO=12345678
FACTURA_VIGENCIA=2026-12-31
FACTURA_ESTABLECIMIENTO=001
FACTURA_PUNTO_EXPEDICION=001
# Dejar vacío para modo simulación
SIFEN_URL=
SIFEN_URL_CONSULTA=

# --- Misc ---------------------------------------------------------------------
NODE_ENV=production
ALLOW_SEED=false

# --- Límites de la conexión a PostgreSQL --------------------------------------
# Todos opcionales; los defaults son los que usa el backend si no están.
#
# statement_timeout: corta la consulta que se desbocó. 30s es holgado — la más
#   lenta medida en un banco de un millón de movimientos era de 2,1 s, y eso
#   antes del índice. Alcanza también a las migraciones, porque corren por el
#   mismo pool: si alguna necesitara más, desplegá esa vez con 0. La de claves
#   foráneas ya se exime sola.
# DB_STATEMENT_TIMEOUT=30s
#
# idle_in_transaction_session_timeout: mata la transacción abandonada, que es
#   la que retiene bloqueos y bloquea a todos los demás.
# DB_IDLE_TX_TIMEOUT=60s
#
# Tamaño del pool. 10 es el default de node-postgres; se declara para poder
#   ajustarlo sin tocar código. Subirlo sin medir sólo consume conexiones del
#   servidor: Node es de un solo hilo y acá la concurrencia es de E/S.
# DB_POOL_SIZE=10
#
# Cuánto espera una petición por una conexión libre antes de fallar. En 0
#   espera para siempre, que era el comportamiento anterior.
# DB_CONNECTION_TIMEOUT_MS=10000

